# Environment variables template
# Copy this file to .env and set the real values.

# Django
SECRET_KEY=your-secret-key-here-change-it-in-production
DEBUG=True

# Database
DATABASE_URL=sqlite:///db.sqlite3
# Production example:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/service_marketplace

# Allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Maps provider key (set manually; leave empty to show setup warning)
MAPS_API_KEY=
